---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
---

<Layout>
  <ProjectCard
    title="Kindrel"
    description="Household internet plan comparison and savings workflows."
    href="https://kindrel.netlify.app/"
    status="Public Beta"
    image="/images/kindrel/icon.svg"
    imageAlt="Kindrel app icon"
  />
  <ProjectCard
    title="Setform"
    description="Swimming/workout tracking and structured training data."
    href="https://setform-app.netlify.app/"
    status="Public Beta"
    image="/images/setform/icon.svg"
    imageAlt="Setform app icon"
  />
  <ProjectCard
    title="ShelfMath"
    description="Grocery unit-pricing and shopper decision support."
    href="/projects/shelfmath"
    status="In Development"
  />
</Layout>
