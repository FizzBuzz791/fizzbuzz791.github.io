---
const { title, description, href, status, image, imageAlt = "" } = Astro.props;
---

<a class="project-card" href={href}>
  {image && (
    <img class="project-image" src={image} alt={imageAlt} />
  )}

  <div class="project-content">
    <div class="project-header">
      <h3>{title}</h3>
      <span>{status}</span>
    </div>

    <p>{description}</p>
  </div>
</a>
